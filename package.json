{
  "name": "agent-interop-runtime",
  "version": "0.3.0",
  "mcpName": "io.github.Praket7/agent-interop-runtime",
  "description": "A local coordination and reliability MCP runtime for native coding agent sessions.",
  "keywords": [
    "mcp",
    "agents",
    "interop",
    "codex",
    "opencode",
    "claude",
    "cursor",
    "multi-agent",
    "handoff",
    "coordination",
    "reliability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Praket7/agent-interop-runtime.git"
  },
  "homepage": "https://github.com/Praket7/agent-interop-runtime#readme",
  "bugs": {
    "url": "https://github.com/Praket7/agent-interop-runtime/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "agent-interop-runtime": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "PRIVACY.md",
    "docs",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "lint": "node scripts/lint.mjs",
    "pty:probe": "pnpm build && node scripts/probe-pty.mjs",
    "mcp:validate": "node scripts/validate-mcp.mjs",
    "bench": "node --import tsx scripts/benchmark.mjs",
    "bench:check": "node --import tsx scripts/check-bench.mjs",
    "pack:check": "pnpm mcp:validate && pnpm build && pnpm pack --pack-destination work",
    "schema:check": "node --import tsx scripts/check-tool-catalog.mjs"
  },
  "engines": {
    "node": ">=20 <27"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-tiktoken": "^1.0.21",
    "node-pty": "1.2.0-beta.15",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
